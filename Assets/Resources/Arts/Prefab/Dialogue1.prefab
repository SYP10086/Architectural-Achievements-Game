  m_Name: 
  m_EditorClassIdentifier: 
  Name: Level 1
  dialoguePanel: {fileID: 1092718074828037421}
  hasShown: 0
  dialogueText: {fileID: 4800157167444725694}
  sentences:
  - "\u81EA\u5BC6\u5DDE\u6297\u65F1\uFF0C\u81F3\u676D\u5DDE\u6CBB\u6C34\uFF0C\u82CF\u8F7C\u7684\u4E3A\u5B98\u4E4B\u8DEF\uFF0C\u662F\u4E00\u6761\u7531\u5EFA\u7B51\u4E0E\u8BD7\u6587\u5171\u540C\u954C\u523B\u7684\u6587\u5316\u8F68\u8FF9\u3002"
  - "\u800C\u4ECA,\u8FD9\u5E45\u65C5\u9014\u957F\u5377\u6B63\u5F85\u5C55\u5F00,\u542F\u7A0B\u7684\u7B2C\u4E00\u7AD9\uFF0C\u4FBF\u662F\u9547\u6C5F\u3010\u91D1\u5C71\u5BFA\u3011\u3002"
  - "\u2014\u2014\u5728\u6B64\uFF0C\u4ED6\u5C06\u5199\u4E0B\u201C\u6C5F\u5FC3\u4F3C\u6709\u70AC\u706B\u660E\u201D\uFF0C\u4EA6\u5C06\u627E\u5230\u4ED5\u9014\u6CE2\u6F9C\u4E2D\u7684\u7CBE\u795E\u951A\u70B9\u3002"
