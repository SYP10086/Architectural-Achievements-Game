  m_Script: {fileID: 11500000, guid: 57dfd1fef8f0d904aac4db88399410e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Name: 
  dialoguePanel: {fileID: 2349408513784060239}
  hasShown: 0
  dialogueText: {fileID: 6333139368523403585}
  sentences:
  - "\u6211\u8BB0\u5F97\u8FD9\u5EA7\u66FE\u7ECF\u95FB\u540D\u9050\u8FE9\u7684\u91D1\u5C71\u5BFA......."
  - "\u8FD9\u662F\u6211\u7B2C\u4E8C\u6B21\u6765\u4E86,\u98DE\u6A90\u6597\u62F1\u4F9D\u7136\u5982\u5F80\u5E38\u4E00\u6837\u95EA\u70C1\u7740\u91D1\u5149\u3002"
  - "\u90A3\u4E00\u5E74\uFF0C\u6211\u56E0\u201C\u4E4C\u53F0\u8BD7\u6848\u201D\u88AB\u8D2C\u9EC4\u5DDE\uFF0C\u5199\u4E0B\u201C\u7F81\u6101\u754F\u665A\u5BFB\u5F52\u696B\u201D\uFF0C\u5982\u4ECA\u60F3\u6765\uFF0C\u771F\u662F\u4E3A\u8D4B\u65B0\u8BCD\u5F3A\u8BF4\u6101\u3002"
  - "\u5927\u6C5F\u4E1C\u53BB\uFF0C\u5343\u5E06\u8FC7\u5C3D\uFF0C\u4E2A\u4EBA\u8363\u8FB1\u5F97\u5931\uFF0C\u5728\u8FD9\u4E98\u53E4\u7684\u5C71\u6C34\u9762\u524D\uFF0C\u6E3A\u5C0F\u5F97\u5982\u540C\u6C99\u783E......\r\n\r\n"
  - "\u6C5F\u5FC3\u4F3C\u6709\u70AC\u706B\u660E\uFF0C\u98DE\u7130\u7167\u5C71\u6816\u9E1F\u60CA\u3002"
  - "\u4EBA\u751F\u4F55\u5904\u4E0D\u91D1\u5C71\uFF1F\u5FC3\u5B89\u5904\uFF0C\u5373\u662F\u5F52\u9014\u3002"
