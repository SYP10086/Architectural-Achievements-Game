      propertyPath: sentences.Array.data[1]
      value: "\u5EFA\u4EAD\u90A3\u65E5\uFF0C\u6211\u7279\u610F\u5429\u5490\u5DE5\u5320\u83AB\u8981\u96D5\u7422\u8FC7\u751A\u3002\u96E9\u6CC9\u4EAD\u5F53\u5982\u8FD9\u5C71\u95F4\u6E05\u6CC9\uFF0C\u6D51\u7136\u5929\u6210\u624D\u597D\u3002\u770B\u7740\u4ED6\u4EEC\u4F9D\u5C71\u52BF\u7ACB\u8D77\u516B\u6839\u67A3\u6728\u67F1\uFF0C\u69AB\u536F\u76F8\u5408\uFF0C\u6A90\u89D2\u5982\u98DE\u9E1F\u5C55\u7FC5\u2014\u2014\u8981\u7684\u5C31\u662F\u8FD9\u822C\u62D9\u6734\u6C14\u8C61\u3002"
