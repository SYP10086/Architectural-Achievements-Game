--- !u!114 &2126766650
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2126766647}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 57dfd1fef8f0d904aac4db88399410e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Name: Level 1
  dialoguePanel: {fileID: 1669096411}
  hasShown: 0
  dialogueText: {fileID: 214879171}
  sentences:
  - "\u81EA\u5BC6\u5DDE\u6297\u65F1\uFF0C\u81F3\u676D\u5DDE\u6CBB\u6C34\uFF0C\u82CF\u8F7C\u7684\u4E3A\u5B98\u4E4B\u8DEF\uFF0C\u662F\u4E00\u6761\u7531\u5EFA\u7B51\u4E0E\u8BD7\u6587\u5171\u540C\u954C\u523B\u7684\u6587\u5316\u8F68\u8FF9\u3002"
  - "\u800C\u4ECA\uFF0C\u8FD9\u5E45\u65C5\u9014\u957F\u5377\u6B63\u5F85\u5C55\u5F00,\u542F\u7A0B\u7684\u7B2C\u4E00\u7AD9\uFF0C\u4FBF\u662F\u9547\u6C5F\u3010\u91D1\u5C71\u5BFA\u3011\u3002"
  - "\u2014\u2014\u5728\u6B64\uFF0C\u4ED6\u5C06\u5199\u4E0B\u201C\u6C5F\u5FC3\u4F3C\u6709\u70AC\u706B\u660E\u201D\uFF0C\u4EA6\u5C06\u627E\u5230\u4ED5\u9014\u6CE2\u6F9C\u4E2D\u7684\u7CBE\u795E\u951A\u70B9\u3002"
--- !u!114 &2126766651
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2126766647}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 57dfd1fef8f0d904aac4db88399410e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Name: Level 3
  dialoguePanel: {fileID: 1711900582}
  hasShown: 0
  dialogueText: {fileID: 1653662578}
  sentences:
  - "\u5357\u4E0B\u81F3\u676D\u5DDE\uFF0C\u82CF\u8F7C\u5DF2\u6E10\u4ECE\u4E16\u4E8B\u6CE2\u6F9C\u4E2D\u6DEC\u70BC\u51FA\u8C41\u8FBE\u3002"
  - "\u5728\u6B64\uFF0C\u4ED6\u758F\u897F\u6E56\u3001\u7B51\u82CF\u5824\uFF0C\u66F4\u4E8E\u897F\u5B50\u6E56\u7554\u5EFA\u8D77\u3010\u671B\u6E56\u697C\u3011\u3002"
  - "\u6B64\u697C\u4E0D\u518D\u4EC5\u662F\u89C2\u6F6E\u542C\u96E8\u4E4B\u6240\uFF0C\u66F4\u662F\u4ED6\u8BD7\u5FC3\u4E0E\u5320\u610F\u878D\u6C47\u7684\u5DC5\u5CF0"
  - "\u2014\u2014\u5982\u4F55\u4EE5\u6728\u77F3\u62B5\u5FA1\u5927\u6F6E\uFF0C\u4EE5\u7A97\u7256\u6536\u7EB3\u98CE\u4E91\uFF0C\u4EE5\u58A8\u8FF9\u9898\u548F\u5C71\u6CB3\u3002"
--- !u!114 &2126766652
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2126766647}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 57dfd1fef8f0d904aac4db88399410e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Name: Level 2
  dialoguePanel: {fileID: 1459195411}
  hasShown: 0
  dialogueText: {fileID: 1649659505}
  sentences:
  - "\u544A\u522B\u91D1\u5C71\u5BFA\u7684\u6C5F\u98CE\u7985\u97F5\uFF0C\u82CF\u8F7C\u7684\u811A\u6B65\u8FC8\u5411\u5317\u65B9\u65F1\u586C\u3002"
  - "\u5728\u5BC6\u5DDE\uFF0C\u4ED6\u9762\u5BF9\u7684\u4E0D\u4EC5\u662F\u9F9F\u88C2\u7684\u571F\u5730\uFF0C\u8FD8\u6709\u7126\u707C\u7684\u6C11\u5FC3\u3002"
  - "\u4E8E\u6B64\uFF0C\u4ED6\u4EB2\u52D8\u6C34\u6E90\u3001\u4E3B\u6301\u7948\u96E8\uFF0C\u66F4\u4EE5\u58EB\u4EBA\u4E4B\u5FC3\u4E0E\u5DE5\u5320\u4E4B\u667A\uFF0C\u7B51\u8D77\u3010\u96E9\u6CC9\u4EAD\u3011\u2014\u2014\u4E00\u5EA7\u4E0D\u4EE5\u89C2\u666F\u4E3A\u8981\uFF0C\u800C\u4EE5\u6C11\u751F\u4E3A\u9B42\u7684\u5EFA\u7B51\u3002"
  - "\u6B64\u4EAD\u89C1\u8BC1\u4E86\u4ED6\u4ECE\u6587\u4EBA\u5230\u5B9E\u5E72\u8005\u7684\u8F6C\u53D8\uFF0C\u4E5F\u57CB\u4E0B\u4E86\u2018\u5179\u6CC9\u7531\u4E08\u4EBA\u5F00\uFF0C\u53D1\u4E8E\u82CF\u8F7C\u4E4B\u4E16\u2019\u7684\u8D23\u4EFB\u4E0E\u62C5\u5F53\u3002"
  - "\u5982\u4ECA\uFF0C\u6211\u4EEC\u5C06\u91CD\u73B0\u4EAD\u4E0B\u6697\u6E20\u758F\u901A\u4E4B\u5DE7\u3001\u58F0\u6CC9\u56DE\u54CD\u4E4B\u5999\uFF0C\u89E3\u8BFB\u4E1C\u5761\u5982\u4F55\u4EE5\u5EFA\u7B51\u4E3A\u8BED\u8A00\uFF0C\u4E66\u5199\u4E3A\u5B98\u4E4B\u9053\u3002"
--- !u!1660057539 &9223372036854775807
